{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentskills.local/woo-project-triage/triage.schema.json",
  "title": "WooCommerce Project Triage Report",
  "type": "object",
  "required": ["tool", "project", "signals", "tooling", "features"],
  "properties": {
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "const": "detect_woo_project" },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": ["kind", "primary"],
      "properties": {
        "kind": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "unknown",
              "woo-core",
              "woo-extension",
              "woo-theme",
              "woo-site"
            ]
          }
        },
        "primary": {
          "type": "string",
          "enum": ["unknown", "woo-core", "woo-extension", "woo-theme", "woo-site"]
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "signals": {
      "type": "object",
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "object",
          "properties": {
            "repoRoot": { "type": "string" },
            "wpContent": { "type": ["string", "null"] },
            "pluginsDir": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "hasWpContentDir": { "type": "boolean" },
        "hasPluginsDir": { "type": "boolean" },
        "wooCommerceCore": {
          "type": ["object", "null"],
          "properties": {
            "path": { "type": "string" },
            "header": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "version": { "type": ["string", "null"] },
                "requiresWP": { "type": ["string", "null"] },
                "requiresPHP": { "type": ["string", "null"] },
                "requiresWC": { "type": ["string", "null"] },
                "wcTested": { "type": ["string", "null"] }
              }
            }
          }
        },
        "pluginHeader": {
          "type": ["object", "null"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": ["string", "null"] },
            "requiresWP": { "type": ["string", "null"] },
            "requiresPHP": { "type": ["string", "null"] },
            "requiresWC": { "type": ["string", "null"] },
            "wcTested": { "type": ["string", "null"] }
          }
        },
        "themeName": { "type": ["string", "null"] },
        "hpos": {
          "type": "object",
          "properties": {
            "declaresCompatibility": { "type": "boolean" },
            "usesHPOSApis": { "type": "boolean" },
            "matches": { "type": "object" },
            "scanTruncated": { "type": "boolean" }
          }
        },
        "blockCheckout": {
          "type": "object",
          "properties": {
            "usesBlockCheckout": { "type": "boolean" },
            "extendsStoreApi": { "type": "boolean" },
            "matches": { "type": "object" },
            "scanTruncated": { "type": "boolean" }
          }
        },
        "extensionTypes": {
          "type": "object",
          "properties": {
            "types": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["payment-gateway", "shipping-method", "product-type", "email", "integration", "rest-api"]
              }
            },
            "matches": { "type": "object" },
            "scanTruncated": { "type": "boolean" }
          }
        },
        "hooks": {
          "type": "object",
          "properties": {
            "matches": { "type": "object" },
            "hookCount": { "type": "integer" },
            "scanTruncated": { "type": "boolean" }
          }
        },
        "cli": {
          "type": "object",
          "properties": {
            "hasCliCommands": { "type": "boolean" },
            "matches": { "type": "object" },
            "scanTruncated": { "type": "boolean" }
          }
        },
        "scanTruncated": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "tooling": {
      "type": "object",
      "required": ["php", "node", "tests"],
      "properties": {
        "php": {
          "type": "object",
          "properties": {
            "hasComposerJson": { "type": "boolean" },
            "hasVendorDir": { "type": "boolean" },
            "phpunitXml": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "node": {
          "type": "object",
          "properties": {
            "hasPackageJson": { "type": "boolean" },
            "packageManager": { "type": ["string", "null"], "enum": ["npm", "yarn", "pnpm", "bun", null] },
            "usesWordpressScripts": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "tests": {
          "type": "object",
          "properties": {
            "hasPhpUnit": { "type": "boolean" },
            "hasWpEnv": { "type": "boolean" },
            "hasPlaywright": { "type": "boolean" },
            "hasJest": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "versions": {
      "type": "object",
      "properties": {
        "woocommerce": {
          "type": "object",
          "properties": {
            "value": { "type": ["string", "null"] },
            "source": { "type": ["string", "null"] }
          }
        },
        "requirements": {
          "type": "object",
          "properties": {
            "wcMinimum": { "type": ["string", "null"] },
            "wcTested": { "type": ["string", "null"] },
            "wpMinimum": { "type": ["string", "null"] },
            "phpMinimum": { "type": ["string", "null"] }
          }
        }
      },
      "additionalProperties": true
    },
    "features": {
      "type": "object",
      "properties": {
        "hposCompatible": { "type": "boolean" },
        "blockCheckoutReady": { "type": "boolean" },
        "extensionTypes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hasCliCommands": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "recommendations": {
      "type": "object",
      "properties": {
        "commands": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
